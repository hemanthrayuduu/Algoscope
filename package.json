{
  "name": "leetvision",
  "version": "2.0.0",
  "private": true,
  "description": "Watch your code run. An interactive web app that executes JavaScript and Python step by step and visualizes data structures as they change.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "keywords": [
    "algorithm-visualization",
    "data-structures",
    "step-through",
    "python",
    "javascript",
    "pyodide",
    "d3",
    "education"
  ],
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.28.4",
    "acorn": "^8.12.1",
    "d3": "^7.9.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
